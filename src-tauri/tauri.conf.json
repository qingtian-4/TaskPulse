{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskPulse",
  "version": "0.2.0-alpha.1",
  "identifier": "app.taskpulse.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../scripts/hooks/": "scripts/hooks/" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "System tray monitor for AI coding agents",
    "longDescription": "TaskPulse monitors coding-agent tasks across local projects and remote servers, shows current activity, and alerts you when tasks need attention.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": { "upgradeCode": "6cd0d94e-66e7-5fec-8e52-e96008b6a767" },
      "nsis": { "installMode": "currentUser", "languages": ["English", "SimpChinese"], "displayLanguageSelector": true }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "agenttray.desktop"
      },
      "rpm": {
        "desktopTemplate": "agenttray.desktop"
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    }
  }
}

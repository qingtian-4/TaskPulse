{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskPulse",
  "version": "1.0.0",
  "identifier": "app.taskpulse.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun scripts/dependency-notices.ts licenses"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../scripts/hooks/": "scripts/hooks/",
      "../LICENSE": "LICENSE",
      "../licenses/": "licenses/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "System tray monitor for AI coding agents",
    "longDescription": "TaskPulse monitors coding-agent tasks across local projects and remote servers, shows current activity, and alerts you when tasks need attention.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "6cd0d94e-66e7-5fec-8e52-e96008b6a767",
        "version": "1.0.0.65535"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "agenttray.desktop"
      },
      "rpm": {
        "desktopTemplate": "agenttray.desktop"
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "13.3",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NDhEQUI4REYwQUFFClJXU3VDdCs0MmtnMkFHZDdXU2d4aitVV1QrQUVuSkNsWkc4NWZKUTM2YkdmK1B5MnpaYk5sUWxDCg==",
      "endpoints": [
        "https://github.com/qingtian-4/TaskPulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}

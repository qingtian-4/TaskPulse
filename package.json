{
  "name": "agent-tray",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/verify-frontend-assets.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:ui-model": "bun test ./tests/settings.test.ts ./tests/autostart.test.ts ./tests/dashboard.test.ts ./tests/notice.test.ts ./tests/source-setup.test.ts ./tests/request-evaluation.test.ts ./tests/visual.test.ts ./tests/brand.test.ts ./scripts/monitor-sources.test.ts",
    "test:docs": "bun test ./tests/docs.test.ts",
    "test:repo": "bun test ./tests/repository.test.ts",
    "test:installation-preview": "bun test ./tests/installation-preview.test.ts",
    "test:release": "bun test ./tests/release.test.ts ./tests/updater-assets.test.ts ./tests/dependency-notices.test.ts ./tests/release-package.test.ts",
    "audit:frontend": "bun audit --audit-level=moderate",
    "audit:rust": "bun scripts/security.ts rust",
    "audit:secrets": "bun scripts/security.ts secrets",
    "test:security": "bun test ./tests/security.test.ts",
    "test:integration-contract": "bun test ./tests/integration-contract.test.ts",
    "test:smoke-cleanup": "bun test ./tests/smoke-workspace.test.ts",
    "release:check": "bun scripts/release.ts check",
    "tauri": "tauri",
    "dev:desktop": "bun scripts/develop.ts",
    "test:workflow": "bun test ./tests/development.test.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.7.0",
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.12.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qingtian-4/TaskPulse.git"
  }
}

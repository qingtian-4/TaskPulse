{
  "name": "agent-tray",
  "private": true,
  "version": "0.2.0-alpha.8",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:ui-model": "bun test ./scripts/settings.test.ts ./scripts/dashboard.test.ts ./scripts/notice.test.ts ./scripts/source-setup.test.ts ./scripts/visual.test.ts ./scripts/brand.test.ts",
    "test:docs": "bun test ./scripts/docs.test.ts",
    "test:repo": "bun test ./scripts/repository.test.ts",
    "test:installation-preview": "bun test ./scripts/installation-preview.test.ts",
    "test:release": "bun test ./scripts/release.test.ts ./scripts/updater-assets.test.ts",
    "audit:frontend": "bun audit --audit-level=moderate",
    "audit:rust": "bun scripts/security.ts rust",
    "audit:secrets": "bun scripts/security.ts secrets",
    "test:security": "bun test ./scripts/security.test.ts",
    "test:integration-contract": "bun test ./scripts/integration-contract.test.ts",
    "test:smoke-cleanup": "bun test ./scripts/smoke-workspace.test.ts",
    "release:check": "bun scripts/release.ts check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.7.0",
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.12.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qingtian-4/TaskPulse.git"
  }
}
